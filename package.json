{
  "name": "solid-demonstrator",
  "version": "0.0.0",
  "description": "A browser-only Solid app that shows each exchange between the app, the WebID profile, the identity provider and the Pod",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "build": "vite build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:browser && pnpm run docs:lint && pnpm run docs:prose",
    "dev": "vite",
    "docs:lint": "markdownlint-cli2",
    "docs:prose": "git ls-files -z --cached --others --exclude-standard '*.md' | xargs --null vale",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "preview": "vite preview",
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/core/**/*.ts' --test-coverage-include-all --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/core/test-support/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 'src/core/**/*.test.ts'",
    "typecheck": "tsc",
    "workflows:audit": "zizmor --offline .",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "lit": "3.3.3",
    "n3": "2.13.12",
    "oauth4webapi": "3.8.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@playwright/test": "1.64.1",
    "@types/n3": "1.26.6",
    "@types/node": "26.6.10",
    "markdownlint-cli2": "0.24.2",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
